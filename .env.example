# Copy this file to .env.local and fill in real values. Never commit .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/icpc_day?sslmode=require"
# The contest day and the local time zone. Times in the Excel file are read as local times on this date.
EVENT_DATE="2026-11-07"
EVENT_TZ="America/New_York"
# Web push (step 4). Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Any long random string; cron-job.org sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
# Password for /admin. Pick a long one; changing it logs everyone out.
ADMIN_PASSWORD=""
